<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or '99 個商業問題，AI 能解決多少？從商業問題出發，探索 AI 解法，透過實作與測試，看看哪些真的有效。' | escape }}">
    <title>{{ title | escape }}</title>
    <link rel="stylesheet" href="/styles/global.css">
    {% if aboutPage %}<link rel="stylesheet" href="/styles/about.css">{% endif %}
    {% if detailPage %}<link rel="stylesheet" href="/styles/problem-detail.css">{% endif %}
    {% if engineeringPage %}<link rel="stylesheet" href="/styles/engineering.css">{% endif %}
    {% if frameworkPage %}<link rel="stylesheet" href="/styles/framework.css">{% endif %}
    {% if engineeringPage and investigation.hasMath %}<link rel="stylesheet" href="/assets/vendor/katex/katex.min.css">{% endif %}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">跳至主要內容</a>
    {{ content | safe }}
