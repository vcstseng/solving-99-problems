---
layout: layouts/base.njk
pagination:
  data: l3Cases
  size: 1
  alias: investigation
permalink: "{{ investigation.url }}"
eleventyComputed:
  title: "{{ investigation.id }}｜{{ investigation.displayTitle }}｜Solving 99 Problems"
  description: "{{ investigation.displayTitle }}"
detailPage: true
engineeringPage: true
---
<header class="site-header wrap"><a class="wordmark" href="/">Solving 99 Problems <span>AI 解題實錄</span></a><nav aria-label="主要導覽"><a href="/#library">問題庫</a><a href="/#featured">精選案例</a><a href="/#about">關於專案</a></nav></header>
<main class="detail-page engineering-page" id="main" style="--domain-color:{{ investigation.website.color }};--domain-foreground:{{ investigation.website.foreground }}">
  <nav class="wrap detail-breadcrumb" aria-label="所在位置"><a href="/">首頁</a><span aria-hidden="true">/</span><a href="{{ investigation.caseUrl }}">{{ investigation.id }} 案例</a><span aria-hidden="true">/</span><span aria-current="page">工程深讀</span></nav>
  <header class="engineering-hero wrap"><div class="case-cover"><div class="cover-kicker"><span>{{ investigation.website.category | escape }}</span><span>{{ investigation.id }}</span></div><p class="engineering-level">工程深讀</p><h1 id="case-title">{{ investigation.displayTitle | escape }}</h1></div><a class="text-link engineering-back" href="{{ investigation.caseUrl }}">← 返回案例概覽</a></header>
  <div class="reading-layout wrap">
    <article class="case-body" aria-labelledby="case-title">
      <div class="section-prose engineering-introduction">{{ investigation.introductionHtml | safe }}</div>
      {% for section in investigation.sections %}<section class="case-section" data-case-section="{{ section.key }}" aria-labelledby="{{ section.id }}"><header class="chapter-band">{{ section.headingHtml | safe }}</header><div class="section-prose">{{ section.html | safe }}</div></section>{% endfor %}
    </article>
    <aside class="case-sidebar"><details class="toc-shell" open><summary>本頁目錄<span class="toc-chevron" aria-hidden="true"></span></summary><nav class="case-toc" aria-label="本頁目錄"><ol>{% for section in investigation.sections %}<li class="toc-group" data-toc-group="{{ section.key }}"><a href="#{{ section.id }}" data-section-link="{{ section.key }}">{{ section.title | escape }}</a>{% if section.toc.length %}<ol class="toc-children">{% for heading in section.toc %}<li><a href="#{{ heading.id }}">{{ heading.title | escape }}</a></li>{% endfor %}</ol>{% endif %}</li>{% endfor %}</ol></nav></details></aside>
  </div>
  <div class="detail-return wrap"><a class="text-link" href="{{ investigation.caseUrl }}">← 返回 {{ investigation.id }} 案例概覽</a><a class="text-link" href="#top">回到頁首</a></div>
  <dialog class="diagram-dialog" aria-labelledby="diagram-dialog-title"><header><h2 id="diagram-dialog-title">工程流程圖</h2><button type="button" data-close-diagram>關閉</button></header><div class="diagram-dialog-content" tabindex="0"></div></dialog>
</main>
<footer class="site-footer wrap"><div><p class="footer-brand">Solving 99 Problems</p><p>AI 解題實錄</p></div><p>{{ investigation.id }} · 工程深讀</p></footer>
<script defer src="/assets/vendor/mermaid.tiny.js"></script>
<script type="module" src="/assets/engineering.js"></script>
<script type="module" src="/assets/problem-detail.js"></script>
