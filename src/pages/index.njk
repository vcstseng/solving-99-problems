---
layout: layouts/base.njk
title: Solving 99 Problems｜AI 解題實錄
permalink: /
---
{% from "components/research-card.njk" import card, metadata %}
<header class="site-header wrap"><a class="wordmark" href="#top">Solving 99 Problems <span>AI 解題實錄</span></a><nav aria-label="主要導覽"><a href="#library">問題庫</a><a href="#featured">精選案例</a><a href="#about">關於專案</a></nav></header>
<main id="main">
  <section class="intro wrap" aria-labelledby="intro-title">
    <div class="intro-grid"><div class="intro-copy"><p class="eyebrow">99 PROBLEMS</p><h1 id="intro-title">99 個商業問題，<br>AI 能解決多少？</h1><p class="intro-description">從商業問題出發，探索 AI 解法，透過實作與測試，看看哪些真的有效。</p><a class="primary-link" href="#library">探索全部 99 個問題</a></div>
      <div class="category-navigation"><h2 class="category-heading">商業領域｜57 題</h2><nav class="domain-grid" aria-label="10 個商業領域">{% for domain in research.businessDomains %}<a href="#library" data-domain-link="{{ domain.name | escape }}" style="--domain-color:{{ domain.color }};--domain-foreground:{{ domain.foreground }}"><span class="domain-name">{{ domain.name | escape }}</span><span class="domain-count">{{ domain.count }}</span><span class="domain-unit">個問題</span></a>{% endfor %}</nav><a class="text-link ai-category-link" href="#library" data-ai-link>查看其他 42 題：AI 應用分類</a></div></div>
    <dl class="project-stats"><div><dd>99</dd><dt>個問題</dt></div><div><dd>8</dd><dt>個已完成探索</dt></div><div><dd>91</dd><dt>個尚待探索</dt></div></dl>
  </section>
  <section class="featured wrap" id="featured" aria-labelledby="featured-heading"><div class="section-heading"><h2 id="featured-heading">精選案例</h2></div>{{ card(research.featured, true) }}</section>
  <section class="selected wrap" aria-labelledby="selected-heading"><div class="section-heading"><h2 id="selected-heading">更多案例</h2><a class="text-link" href="#library" data-completed-link>查看全部 8 個案例</a></div><div class="case-grid">{% for problem in research.selected %}{{ card(problem, false) }}{% endfor %}</div></section>
  <section class="library wrap" id="library" aria-labelledby="library-heading">
    <div class="section-heading"><h2 id="library-heading">探索全部 99 個問題</h2></div>
    <form class="library-filters" id="library-filters" role="search" aria-label="搜尋與篩選問題">
      <label class="search-field" for="keyword">關鍵字搜尋<input id="keyword" name="keyword" type="search" placeholder="搜尋 ID、問題、技術或工具" autocomplete="off"></label>
      <label for="domain">領域與分類<select id="domain" name="domain"><option value="">全部</option><option value="__ai">AI 應用分類（全部）</option><optgroup label="商業領域">{% for domain in research.businessDomains %}<option value="{{ domain.name | escape }}">{{ domain.name | escape }}（{{ domain.count }}）</option>{% endfor %}</optgroup><optgroup label="AI 應用分類">{% for domain in research.aiDomains %}<option value="{{ domain.name | escape }}">{{ domain.name | escape }}（{{ domain.count }}）</option>{% endfor %}</optgroup></select></label>
      <label for="status">探索進度<select id="status" name="status"><option value="">全部</option><option value="complete">已完成探索</option><option value="pending">尚待探索</option></select></label>
      <label for="technology">核心技術<select id="technology" name="technology"><option value="">全部</option>{% for technology in research.technologies %}<option value="{{ technology | escape }}">{{ technology | escape }}</option>{% endfor %}</select></label>
      <label for="tool">實作工具<select id="tool" name="tool"><option value="">全部</option>{% for tool in research.tools %}<option value="{{ tool | escape }}">{{ tool | escape }}</option>{% endfor %}</select></label><button class="reset-button" type="reset">清除篩選</button>
    </form>
    <div class="library-toolbar"><p id="result-count" role="status" aria-live="polite" aria-atomic="true">共 99 個問題 <span>（已完成探索 8 題，尚待探索 91 題）</span></p><label class="page-size-label" for="page-size">每頁<select id="page-size" aria-label="每頁筆數"><option value="12">12 題</option><option value="24">24 題</option><option value="48">48 題</option></select></label></div>
    <div class="list-head" aria-hidden="true"><span>Problem ID</span><span>問題標題</span><span>問題分類</span><span>核心技術</span><span>實作工具</span><span>探索進度</span><span></span></div>
    <div class="problem-list" id="problem-list">{% for problem in research.problems %}
      <details class="problem-item" id="problem-{{ problem.id }}" data-id="{{ problem.id }}" data-domain="{{ problem.domain | escape }}" data-group="{{ problem.group }}" data-status="{% if problem.completed %}complete{% else %}pending{% endif %}" data-technologies="{{ problem.technologies | join('||') | escape }}" data-tools="{{ problem.tools | join('||') | escape }}" data-search="{{ problem.originalName | escape }} {{ problem.businessProblem | escape }} {{ problem.context | escape }}" style="--domain-color:{{ problem.color }}" {% if loop.index > 12 %}hidden{% endif %}>
        <summary class="problem-summary" aria-controls="library-panel-{{ problem.id }}"><span class="problem-id">{{ problem.id }}</span><span class="problem-title">{{ problem.title | escape }}</span><span class="problem-domain"><span class="mobile-label">問題分類</span>{{ problem.domain | escape }}</span><span class="problem-technology"><span class="mobile-label">核心技術</span>{% if problem.technologies.length %}{{ problem.technologies | take(2) | join('、') | escape }}{% if problem.technologies.length > 2 %}<small> +{{ problem.technologies.length - 2 }}</small>{% endif %}{% else %}<span class="unknown" aria-label="尚無已核實項目">—</span>{% endif %}</span><span class="problem-tool"><span class="mobile-label">實作工具</span>{% if problem.tools.length %}{{ problem.tools | take(2) | join('、') | escape }}{% if problem.tools.length > 2 %}<small> +{{ problem.tools.length - 2 }}</small>{% endif %}{% else %}<span class="unknown" aria-label="尚無已核實項目">—</span>{% endif %}</span><span class="problem-status{% if problem.completed %} complete{% endif %}">{{ problem.status }}</span><span class="disclosure" aria-hidden="true"></span></summary>
        <div class="problem-panel" id="library-panel-{{ problem.id }}">{% if problem.completed %}<dl class="actual-metadata">{{ metadata("核心技術", problem.technologies, problem.id, true) }}{{ metadata("實作工具", problem.tools, problem.id, true) }}</dl>{% else %}<div class="problem-definition"><h3>{{ problem.originalName | escape }}</h3><dl><div><dt>問題描述</dt><dd>{{ problem.businessProblem | escape }}</dd></div><div><dt>商業情境</dt><dd>{{ problem.context | escape }}</dd></div><div><dt>所需資料／既有系統</dt><dd>{{ problem.requiredData | escape }}</dd></div></dl></div>{% endif %}<button type="button" class="close-panel" data-close-row="{{ problem.id }}">收合內容</button></div>
      </details>{% endfor %}</div>
    <div class="empty-state" id="empty-state" hidden><h3>沒有符合條件的問題</h3><p>試著更換關鍵字，或清除部分篩選條件。</p><button type="button" data-clear-filters>清除篩選</button></div>
    <noscript><p class="no-script">請啟用 JavaScript，以搜尋、篩選及分頁。目前顯示前 12 題，可展開技術、工具或問題描述。</p></noscript>
    <div class="pagination-footer"><p id="page-range">1–12 / 99</p><nav class="pagination" id="pagination" aria-label="問題列表分頁"></nav></div>
  </section>
</main>
<footer class="site-footer wrap" id="about"><div><p class="footer-brand">Solving 99 Problems</p><p>AI 解題實錄</p></div><p>從商業問題出發，探索 AI 解法。</p><a class="text-link" href="#top">回到頁首</a></footer>
<script type="module" src="/assets/library.js"></script>
